# ---------------------------------------------------------------------
# 카페24 등 '문서 루트를 바꿀 수 없는' 호스팅용 (DEPLOY_CAFE24.md 의 방법 B)
#
# 프로젝트 전체를 www/ 에 올렸을 때, 모든 요청을 public/ 으로 넘긴다.
# app/ · writable/ · vendor/ · .env 는 주소로 직접 열 수 없게 된다.
# (방법 A — public/ 내용만 www/ 에 두는 방식 — 에서는 이 파일이 필요 없다)
# ---------------------------------------------------------------------
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# 점(.)으로 시작하는 파일(.env, .git …)은 어떤 경우에도 내보내지 않는다
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
